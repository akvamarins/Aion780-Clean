<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="item_groups">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="craft_materials" type="CraftItemGroup"/>
                <xs:element name="craft_shop" type="CraftItemGroup"/>
                <xs:element name="craft_bundles" type="CraftRecipeGroup"/>
                <xs:element name="craft_recipes" type="CraftRecipeGroup"/>
                <xs:element name="manastones_common" type="ManastoneGroup"/>
                <xs:element name="manastones_rare" type="ManastoneGroup"/>
                <xs:element name="medals" type="MedalGroup"/>
                <xs:element name="food_common" type="FoodGroup"/>
                <xs:element name="food_rare" type="FoodGroup"/>
                <xs:element name="food_legendary" type="FoodGroup"/>
                <xs:element name="food" type="FoodGroup"/>
                <xs:element name="medicine" type="MedicineGroup"/>
                <xs:element name="medicine_common" type="MedicineGroup"/>
                <xs:element name="medicine_rare" type="MedicineGroup"/>
                <xs:element name="medicine_legendary" type="MedicineGroup"/>
                <xs:element name="ore" type="OreGroup"/>
                <xs:element name="ores_rare" type="OreGroup"/>
                <xs:element name="ores_legendary" type="OreGroup"/>
                <xs:element name="ores_unique" type="OreGroup"/>
                <xs:element name="ores_epic" type="OreGroup"/>
                <xs:element name="gather" type="GatherGroup"/>
                <xs:element name="gather_rare" type="GatherGroup"/>
                <xs:element name="enchant" type="EnchantGroup"/>
                <xs:element name="enchants" type="EnchantGroup"/>
                <xs:element name="boss" type="BossGroup"/>
                <xs:element name="boss_rare" type="BossGroup"/>
                <xs:element name="boss_legendary" type="BossGroup"/>
                <xs:element name="manastone" type="ManastoneGroup"/>
                <xs:element name="feed_fluid" type="FeedFluidGroup"/>
                <xs:element name="feed_armor" type="FeedArmorGroup"/>
                <xs:element name="feed_thorn" type="FeedThornGroup"/>
                <xs:element name="feed_bone" type="FeedBoneGroup"/>
                <xs:element name="feed_balaur_material" type="FeedBalaurGroup"/>
                <xs:element name="feed_soul" type="FeedSoulGroup"/>
                <xs:element name="feed_exclude" type="FeedExcludeGroup"/>
                <xs:element name="stinking_junk" type="StinkingJunkGroup"/>
                <xs:element name="feed_healthy_all" type="HealthyFoodAllGroup"/>
                <xs:element name="feed_healthy_spicy" type="HealthyFoodSpicyGroup"/>
                <xs:element name="feed_powder_biscuit" type="AetherPowderBiscuitGroup"/>
                <xs:element name="feed_crystal_biscuit" type="AetherCrystalBiscuitGroup"/>
                <xs:element name="feed_gem_biscuit" type="AetherGemBiscuitGroup"/>
                <xs:element name="poppy_snack" type="PoppySnackGroup"/>
                <xs:element name="tasty_poppy_snack" type="PoppySnackTastyGroup"/>
                <xs:element name="nutritious_poppy_snack" type="PoppySnackNutritiousGroup"/>
                <xs:element name="feed_shugo_event_coin" type="ShugoEventCoinGroup"/>
                <xs:element name="bonus_groups" type="AnyGroup"/>
                <xs:element name="craft_groups" type="AnyGroup"/>
                <xs:element name="feed_groups" type="AnyGroup"/>
                <xs:element name="allBonusGroups" type="AnyGroup"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="AnyGroup"><xs:sequence><xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/></xs:sequence></xs:complexType>

    <xs:complexType name="BonusItemGroup" abstract="true">
        <xs:attribute name="bonusType" type="BonusType" use="required"/>
        <xs:attribute name="chance" type="xs:float" use="optional" default="0"/>
    </xs:complexType>

    <xs:complexType name="FeedItemGroup" abstract="true">
        <xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="ItemRaceEntry"/></xs:sequence>
        <xs:attribute name="group" type="ItemGroupIndex" use="optional"/>
    </xs:complexType>

    <xs:complexType name="CraftItemGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="CraftItem"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="CraftRecipeGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="CraftRecipe"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="CraftReward" abstract="true"><xs:attribute name="id" type="xs:int" use="required"/><xs:attribute name="skill" type="xs:int" use="optional"/><xs:attribute name="race" type="ItemRace" use="optional"/></xs:complexType>
    <xs:complexType name="CraftItem"><xs:complexContent><xs:extension base="CraftReward"><xs:attribute name="minLevel" type="xs:int" use="required"/><xs:attribute name="maxLevel" type="xs:int" use="required"/></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="CraftRecipe"><xs:complexContent><xs:extension base="CraftReward"><xs:attribute name="level" type="xs:int" use="required"/></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="ManastoneGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="ItemRaceEntry"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="MedalGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="MedalReward"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="MedicineGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="IdLevelReward"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="FoodGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="IdLevelReward"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="OreGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="ItemRaceEntry"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="GatherGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="ItemRaceEntry"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="EnchantGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="IdLevelReward"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="BossGroup"><xs:complexContent><xs:extension base="BonusItemGroup"><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="item" type="ItemRaceEntry"/></xs:sequence></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="FeedFluidGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="FeedArmorGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="FeedThornGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="FeedBalaurGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="FeedBoneGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="FeedSoulGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="FeedExcludeGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="StinkingJunkGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="HealthyFoodAllGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="HealthyFoodSpicyGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="AetherPowderBiscuitGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="AetherCrystalBiscuitGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="AetherGemBiscuitGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="PoppySnackGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="PoppySnackTastyGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="PoppySnackNutritiousGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="ShugoEventCoinGroup"><xs:complexContent><xs:extension base="FeedItemGroup"/></xs:complexContent></xs:complexType>
    <xs:complexType name="ItemRaceEntry"><xs:attribute name="id" type="xs:int" use="required"/><xs:attribute name="race" type="ItemRace" use="optional"/></xs:complexType>
    <xs:complexType name="IdLevelReward"><xs:complexContent><xs:extension base="ItemRaceEntry"><xs:attribute name="level" type="xs:int" use="required"/></xs:extension></xs:complexContent></xs:complexType>
    <xs:complexType name="MedalReward"><xs:complexContent><xs:extension base="IdLevelReward"><xs:attribute name="count" type="xs:int" use="required"/><xs:attribute name="chance" type="xs:float" use="required"/></xs:extension></xs:complexContent></xs:complexType>

    <xs:simpleType name="BonusType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="NONE"/><xs:enumeration value="BOSS"/><xs:enumeration value="COIN"/><xs:enumeration value="ENCHANT"/><xs:enumeration value="FOOD"/><xs:enumeration value="FORTRESS"/><xs:enumeration value="GATHER"/><xs:enumeration value="GOODS"/><xs:enumeration value="ISLAND"/><xs:enumeration value="LUNAR"/><xs:enumeration value="MAGICAL"/><xs:enumeration value="MANASTONE"/><xs:enumeration value="MASTER_RECIPE"/><xs:enumeration value="MATERIAL"/><xs:enumeration value="MEDAL"/><xs:enumeration value="MEDICINE"/><xs:enumeration value="MOVIE"/><xs:enumeration value="RECIPE"/><xs:enumeration value="REDEEM"/><xs:enumeration value="RIFT"/><xs:enumeration value="TASK"/><xs:enumeration value="UNKNOWN"/><xs:enumeration value="WINTER"/><xs:enumeration value="ORE"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="ItemRace"><xs:restriction base="xs:string"><xs:enumeration value="PC_ALL"/><xs:enumeration value="ELYOS"/><xs:enumeration value="ASMODIANS"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="ItemGroupIndex"><xs:restriction base="xs:string"><xs:enumeration value="NONE"/><xs:enumeration value="JUNK"/></xs:restriction></xs:simpleType>
</xs:schema>
