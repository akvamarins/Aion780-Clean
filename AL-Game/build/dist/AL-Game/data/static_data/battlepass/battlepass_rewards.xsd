<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="battlepass_rewards">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="reward" type="DaevaPassReward" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="DaevaPassReward">
        <xs:sequence>
            <xs:element name="light_basic" type="DaevaPassItemList" minOccurs="0"/>
            <xs:element name="light_unlock" type="DaevaPassItemList" minOccurs="0"/>
            <xs:element name="dark_basic" type="DaevaPassItemList" minOccurs="0"/>
            <xs:element name="dark_unlock" type="DaevaPassItemList" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:int" use="required"/>
        <xs:attribute name="season_id" type="xs:int" use="required"/>
        <xs:attribute name="level" type="xs:int" use="required"/>
        <xs:attribute name="point_reward" type="xs:int"/>
    </xs:complexType>

    <xs:complexType name="DaevaPassItemList">
        <xs:sequence>
            <xs:element name="item" type="DaevaPassRewardItem" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DaevaPassRewardItem">
        <xs:attribute name="id" type="xs:int" use="required"/>
        <xs:attribute name="count" type="xs:int"/>
    </xs:complexType>
</xs:schema>
