<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <!-- FIXED for Java 17 - allows all custom attributes used in Aion 7.8+ drops -->
  <xs:complexType name="dropGroup">
    <xs:sequence>
      <xs:element name="drop" maxOccurs="unbounded" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="item_id" type="xs:int" use="optional"/>
          <xs:attribute name="itemId" type="xs:int" use="optional"/>
          <xs:attribute name="min" type="xs:long" use="optional" default="1"/>
          <xs:attribute name="max" type="xs:long" use="optional" default="1"/>
          <xs:attribute name="min_amount" type="xs:long" use="optional"/>
          <xs:attribute name="max_amount" type="xs:long" use="optional"/>
          <xs:attribute name="chance" type="xs:float" use="optional"/>
          <xs:attribute name="no_reduce" type="xs:string" use="optional"/>
          <xs:attribute name="each" type="xs:string" use="optional"/>
          <xs:attribute name="eachmember" type="xs:string" use="optional"/>
          <xs:attribute name="each_member" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="skip"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="race" type="xs:string" use="optional"/>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="use_category" type="xs:string" use="optional"/>
    <xs:attribute name="useCategory" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="dropList">
    <xs:sequence>
      <xs:choice maxOccurs="unbounded" minOccurs="0">
        <xs:element name="drop_group" type="dropGroup"/>
        <xs:element name="common_drop_group" type="dropGroup"/>
        <xs:element name="dropGroup" type="dropGroup"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="npc_id" type="xs:int" use="optional"/>
    <xs:attribute name="npcId" type="xs:int" use="optional"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <xs:element name="npc_drops">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="npc_drop" type="dropList" maxOccurs="unbounded" minOccurs="0"/>
      </xs:sequence>
      <xs:anyAttribute processContents="skip"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
